// Boot splash matching the mytheme GRUB theme

screen.w = Window.GetWidth();
screen.h = Window.GetHeight();

Window.SetBackgroundTopColor(0, 0, 0);
Window.SetBackgroundBottomColor(0, 0, 0);

// Wallpaper, stretched to the screen
background.image = Image("background.png").Scale(screen.w, screen.h);
background.sprite = Sprite(background.image);
background.sprite.SetZ(-100);

// Password box, hidden until a password is asked for
entry.image = Image("entry.png");
entry.sprite = Sprite(entry.image);
entry.x = screen.w / 2 - entry.image.GetWidth() / 2;
entry.y = screen.h * 0.78;
entry.sprite.SetPosition(entry.x, entry.y, 10);
entry.sprite.SetOpacity(0);

bullet.image = Image("bullet.png");
bullet.pad = 20;
bullet.gap = 8;
bullet.max = Math.Int((entry.image.GetWidth() - 2 * bullet.pad) / (bullet.image.GetWidth() + bullet.gap));

// Fixed label instead of Fedora's long "Please enter passphrase for disk luks-..."
prompt.text = "Disk password";
prompt.sprite = Sprite();
prompt.sprite.SetOpacity(0);
prompt.shadow = Sprite();
prompt.shadow.SetOpacity(0);

message.sprite = Sprite();
message.shadow = Sprite();

// Near-white text with a dark shadow so it stays readable over the wallpaper
fun text(str, size)
  {
    return Image.Text(str, 0.9, 0.96, 1, 1, "Cantarell " + size);
  }

fun shadow(str, size)
  {
    return Image.Text(str, 0, 0, 0, 0.8, "Cantarell " + size);
  }

fun hide_password()
  {
    entry.sprite.SetOpacity(0);
    prompt.sprite.SetOpacity(0);
    prompt.shadow.SetOpacity(0);
    for (i = 0; bullet.sprites[i]; i++)
      bullet.sprites[i].SetOpacity(0);
  }

fun display_normal_callback()
  {
    hide_password();
  }

fun display_password_callback(prompt_text, bullets)
  {
    entry.sprite.SetOpacity(1);

    prompt.image = text(prompt.text, 14);
    prompt.x = screen.w / 2 - prompt.image.GetWidth() / 2;
    prompt.y = entry.y - prompt.image.GetHeight() - 14;
    prompt.sprite.SetImage(prompt.image);
    prompt.sprite.SetPosition(prompt.x, prompt.y, 10);
    prompt.sprite.SetOpacity(1);
    prompt.shadow.SetImage(shadow(prompt.text, 14));
    prompt.shadow.SetPosition(prompt.x + 2, prompt.y + 2, 9);
    prompt.shadow.SetOpacity(1);

    for (i = 0; bullet.sprites[i] || i < bullets; i++)
      {
        if (!bullet.sprites[i])
          {
            bullet.sprites[i] = Sprite(bullet.image);
            bullet.sprites[i].SetPosition(
              entry.x + bullet.pad + i * (bullet.image.GetWidth() + bullet.gap),
              entry.y + entry.image.GetHeight() / 2 - bullet.image.GetHeight() / 2,
              11);
          }
        if (i < bullets && i < bullet.max)
          bullet.sprites[i].SetOpacity(1);
        else
          bullet.sprites[i].SetOpacity(0);
      }
  }

fun message_callback(str)
  {
    message.image = text(str, 12);
    message.x = screen.w / 2 - message.image.GetWidth() / 2;
    message.y = screen.h * 0.9;
    message.sprite.SetImage(message.image);
    message.sprite.SetPosition(message.x, message.y, 10);
    message.shadow.SetImage(shadow(str, 12));
    message.shadow.SetPosition(message.x + 2, message.y + 2, 9);
  }

Plymouth.SetDisplayNormalFunction(display_normal_callback);
Plymouth.SetDisplayPasswordFunction(display_password_callback);
Plymouth.SetMessageFunction(message_callback);
